{
  "name": "meoxp-bot",
  "version": "2.0.0",
  "description": "Discord Music Bot with TypeScript and Moodenglink",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --import tsx scripts/smoke.ts",
    "lint": "biome lint src tests",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "node scripts/install-git-hooks.mjs",
    "setup:hooks": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@seald-io/nedb": "4.1.2",
    "cors": "2.8.6",
    "discord.js": "14.28.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "moodenglink": "github:Moodeng-LAB/moodenglink",
    "socket.io": "4.8.4",
    "systeminformation": "5.33.19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  }
}
